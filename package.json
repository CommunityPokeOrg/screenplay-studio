{
  "name": "screenplay-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Screenplay writing app: React + Vite + TypeScript + Tailwind frontend, Cloudflare Workers + D1 + R2 backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply screenplay-studio --local",
    "db:migrate": "wrangler d1 migrations apply screenplay-studio --remote"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "hono": "^4.9.9",
    "jspdf": "^3.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
